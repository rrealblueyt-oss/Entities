entity:SetCallback("OnSpawned", function()
    local entityModel = entity.Model
    if entityModel then
        local primaryPart = entityModel.PrimaryPart or entityModel:FindFirstChildWhichIsA("BasePart")
        if primaryPart then
            local pointLight = Instance.new("PointLight")
            pointLight.Color = Color3.fromRGB(255, 255, 255)
            pointLight.Brightness = 3
            pointLight.Range = 30
            pointLight.Parent = primaryPart
        end

        local function GetGitSound(GithubSnd, SoundName)
            local url = GithubSnd
            if not isfile(SoundName .. ".mp3") then
                writefile(SoundName .. ".mp3", game:HttpGet(url))
            end
            local sound = Instance.new("Sound")
            sound.SoundId = (getcustomasset or getsynasset)(SoundName .. ".mp3")
            return sound
        end

        local zephyr = game.Workspace["???"].A120New
        local Jumpscare = GetGitSound("https://raw.githubusercontent.com/rrealblueyt-oss/Mp3/main/a120%20.mp3?raw=true", "lol")
        Jumpscare.Parent = zephyr
        Jumpscare.Volume = 10
        Jumpscare.PlaybackSpeed = 1
        Jumpscare.Looped = true
        Jumpscare.PlaybackRegionsEnabled = true
        Jumpscare.PlaybackRegion = NumberRange.new(0, 9)
        Jumpscare:Play()
    end
end)

